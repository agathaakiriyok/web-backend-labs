generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  feedbacks Feedback[]
  orders    Order[]

  @@map("users")
}

model Hall {
  id          Int          @id @default(autoincrement())
  name        String
  capacity    Int
  exhibitions Exhibition[]
  orderItems  OrderItem[]

  @@map("halls")
}

model Exhibition {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  dateStart   DateTime
  dateEnd     DateTime
  hallId      Int
  hall        Hall        @relation(fields: [hallId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]

  @@map("exhibitions")
}

model Order {
  id         Int         @id @default(autoincrement())
  userId     Int
  status     OrderStatus @default(PENDING)
  totalPrice Decimal     @db.Decimal(10, 2)
  createdAt  DateTime    @default(now())
  items      OrderItem[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("orders")
}

model OrderItem {
  id           Int        @id @default(autoincrement())
  orderId      Int
  exhibitionId Int
  hallId       Int
  quantity     Int        @default(1)
  unitPrice    Decimal    @db.Decimal(10, 2)
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Restrict)
  hall         Hall       @relation(fields: [hallId], references: [id], onDelete: Restrict)
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}
