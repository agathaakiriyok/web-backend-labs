generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}


model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())

  orders    Order[]
  feedbacks Feedback[]

  @@map("users")
}

model Hall {
  id          Int          @id @default(autoincrement())
  name        String
  capacity    Int

  exhibitions Exhibition[]

  @@map("halls")
}

model Exhibition {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  dateStart   DateTime
  dateEnd     DateTime

  hall        Hall      @relation(fields: [hallId], references: [id], onDelete: Cascade)
  hallId      Int

  tickets     Ticket[]

  @@map("exhibitions")
}

model Order {
  id          Int          @id @default(autoincrement())
  createdAt   DateTime     @default(now())
  status      OrderStatus  @default(PENDING)
  totalAmount Float

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  tickets     Ticket[]
  payments    Payment[]

  @@map("orders")
}

model Ticket {
  id           Int        @id @default(autoincrement())
  type         String
  price        Float

  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  exhibitionId Int

  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      Int

  @@map("tickets")
}

model Payment {
  id        Int           @id @default(autoincrement())
  amount    Float
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int

  @@map("payments")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  @@map("feedbacks")
}