<!DOCTYPE html>
<html lang="ru">
<head>{{> head}}<title>Пользователи</title></head>
<body>
{{> header}}
<main class="main">
  <section class="tickets">
    <div class="wrapper">
      <h1>Пользователи</h1>
      <a href="/users/add"><button class="nav__btn">+ Добавить</button></a>
      <ul class="exhibitions-page__list" style="margin-top:20px">
        {{#each users}}
        <li class="exhibitions-page__item">
          <div class="exhibition__content">
            <h3 class="exhibitions-page__name">{{name}}</h3>
            <p>{{email}}</p>
            <form action="/users/{{id}}/delete" method="POST" style="display:inline">
              <button class="nav__btn" style="background:#993c1d">Удалить</button>
            </form>
          </div>
        </li>
        {{/each}}
      </ul>
    </div>
  </section>
</main>
{{> footer}}
</body>
</html>