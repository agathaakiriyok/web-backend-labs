<header class="header">
    <div class="wrapper header__wrapper">
        <div class="logo">
            <img src="/img/logo.png" alt="Логотип Эрмитажа">
        </div>
        <nav class="nav">
            {{> nav}}
        </nav>
        <div>
            {{#if isAuth}}
                <p>Вы вошли как <strong>{{username}}</strong></p>
                <a href="?auth=false"><button class="nav__btn">Выйти</button></a>
            {{else}}
                <a href="?auth=true"><button class="nav__btn">Войти</button></a>
            {{/if}}
        </div>
    </div>
</header>