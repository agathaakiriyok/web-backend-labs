<!DOCTYPE html>
<html lang="ru">
<head>{{> head}}<title>Добавить выставку</title></head>
<body>
{{> header}}
<main class="main">
  <section class="tickets">
    <div class="wrapper">
      <h1>Новая выставка</h1>
      <form class="tickets__form" action="/exhibitions" method="POST">
        <label class="tickets__label">Название:
          <input type="text" name="name" required>
        </label>
        <label class="tickets__label">Описание:
          <textarea name="description" required></textarea>
        </label>
        <label class="tickets__label">Дата начала:
          <input type="date" name="dateStart" required>
        </label>
        <label class="tickets__label">Дата конца:
          <input type="date" name="dateEnd" required>
        </label>
        <label class="tickets__label">Зал:
          <select name="hallId" required>
            {{#each halls}}
            <option value="{{id}}">{{name}} (ID: {{id}})</option>
            {{/each}}
          </select>
        </label>
        <button class="tickets__btn">Сохранить</button>
      </form>
      <p style="text-align:center;margin-top:16px"><a href="/exhibitions">← Назад к выставкам</a></p>
    </div>
  </section>
</main>
{{> footer}}
</body>
</html>
