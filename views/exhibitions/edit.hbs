<!DOCTYPE html>
<html lang="ru">
<head>{{> head}}<title>Редактировать</title></head>
<body>
{{> header}}
<main class="main">
  <section class="tickets">
    <div class="wrapper">
      <h1>Редактировать выставку</h1>
      <form class="tickets__form" action="/exhibitions/{{exhibition.id}}/update" method="POST">
        <label class="tickets__label">Название: <input type="text" name="name" value="{{exhibition.name}}" required></label>
        <label class="tickets__label">Описание: <textarea name="description" required>{{exhibition.description}}</textarea></label>
        <label class="tickets__label">ID зала: <input type="number" name="hallId" value="{{exhibition.hallId}}" required></label>
        <button class="tickets__btn">Сохранить</button>
      </form>
    </div>
  </section>
</main>
{{> footer}}
</body>
</html>