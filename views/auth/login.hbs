<!DOCTYPE html>
<html lang="ru">
<head>
  {{> head}}
  <title>Вход — Эрмитаж</title>
</head>
<body>
  {{> header}}
  <main class="main">
    <div class="auth-page">
      <h1>Вход</h1>

      {{#if error}}
        <p class="auth-page__error">Неверный email или пароль. <a href="/auth/register">Зарегистрироваться?</a></p>
      {{/if}}

      <form class="tickets__form" method="POST" action="/auth/login">
        <label class="tickets__label">
          Email:
          <input type="email" name="email" required autocomplete="email">
        </label>
        <label class="tickets__label">
          Пароль:
          <input type="password" name="password" required autocomplete="current-password">
        </label>
        <button type="submit" class="tickets__btn">Войти</button>
      </form>

      <p class="auth-page__link">Нет аккаунта? <a href="/auth/register">Зарегистрироваться</a></p>
    </div>
  </main>
  {{> footer}}
</body>
</html>
