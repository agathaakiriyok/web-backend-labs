<!DOCTYPE html>
<html lang="ru">
<head>{{> head}}<title>Мои заказы</title></head>
<body>
  {{> header}}
  <main class="main">
    <div class="wrapper">
      <h1>Мои заказы</h1>
      {{#if orders.length}}
        <ul>
          {{#each orders}}
          <li>
            <a href="/orders/{{id}}">
              Заказ №{{id}} — {{status}} — {{totalAmount}} ₽
            </a>
            — {{createdAt}}
            {{#if (eq status "PENDING")}}
              <form method="POST" action="/orders/{{id}}/cancel" style="display:inline">
                <button type="submit">Отменить</button>
              </form>
            {{/if}}
          </li>
          {{/each}}
        </ul>
      {{else}}
        <p>У вас пока нет заказов. <a href="/exhibitions">Посмотреть выставки</a></p>
      {{/if}}
    </div>
  </main>
  {{> footer}}
</body>
</html>