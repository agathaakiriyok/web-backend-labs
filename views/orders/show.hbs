<!DOCTYPE html>
<html lang="ru">
<head>{{> head}}<title>Заказ №{{order.id}}</title></head>
<body>
  {{> header}}
  <main class="main">
    <div class="wrapper">
      <h1>Заказ №{{order.id}}</h1>
      <p>Статус: <strong>{{order.status}}</strong></p>
      <p>Сумма: {{order.totalAmount}} ₽</p>
      <h2>Билеты</h2>
      <ul>
        {{#each order.tickets}}
        <li>{{exhibition.name}} — {{type}} — {{price}} ₽</li>
        {{/each}}
      </ul>
      {{#if (eq order.status "PENDING")}}
        <form method="POST" action="/payments/{{order.id}}/pay">
          <input type="hidden" name="amount" value="{{order.totalAmount}}">
          <button type="submit">Оплатить</button>
        </form>
      {{/if}}
      <a href="/orders">← Назад к заказам</a>
    </div>
  </main>
  {{> footer}}
</body>
</html>